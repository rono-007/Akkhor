{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akshar-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // D1 Database binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akshar-fonts-db",
      "database_id": "f4a24c6b-af9f-44ad-8fee-1c2a0aed2d41"
    }
  ],

  // R2 Storage binding (uncomment once R2 or blob storage is active)
  // "r2_buckets": [
  //   {
  //     "binding": "FONTS_BUCKET",
  //     "bucket_name": "akshar-fonts"
  //   }
  // ],

  // Environment variables
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://akshar.pages.dev"
  },

  // Dev environment overrides
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "development",
        "ALLOWED_ORIGINS": "http://localhost:5173"
      }
    }
  }
}
