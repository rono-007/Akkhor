{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akshar-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // D1 Database binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akshar-fonts-db",
      "database_id": "f4a24c6b-af9f-44ad-8fee-1c2a0aed2d41"
    }
  ],

  // R2 Storage binding (uncomment once R2 or blob storage is active)
  // "r2_buckets": [
  //   {
  //     "binding": "FONTS_BUCKET",
  //     "bucket_name": "akshar-fonts"
  //   }
  // ],

  // Environment variables (securely kept in Worker backend)
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "*",
    "S3_ENDPOINT": "https://br-small-cloud-b4ofouo5.storage.c-6.us-east-2.aws.neon.tech",
    "S3_ACCESS_KEY_ID": "nak_live_3fe1575ecef44d0884d266f8aae28ff4",
    "S3_SECRET_ACCESS_KEY": "nsk_live_8bf4236b3fc37eb8d2170f2908656d860ab141e1586b5c4fad930ea948ece0c0",
    "S3_REGION": "us-east-2",
    "S3_BUCKET": "akshar-fonts"
  },

  // Dev environment overrides
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "development",
        "ALLOWED_ORIGINS": "http://localhost:5173"
      }
    }
  }
}
