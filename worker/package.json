{
  "name": "akshar-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute akshar-fonts-db --file=./src/db/schema.sql",
    "db:seed": "wrangler d1 execute akshar-fonts-db --file=./src/db/seed.sql",
    "db:migrate:local": "wrangler d1 execute akshar-fonts-db --local --file=./src/db/schema.sql",
    "db:seed:local": "wrangler d1 execute akshar-fonts-db --local --file=./src/db/seed.sql"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.99.0"
  }
}
