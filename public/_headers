# Cloudflare Pages Headers

# Font files cache & CORS
/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

# Static assets cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Root & HTML cache
/*.html
  Cache-Control: public, max-age=0, must-revalidate
